[Unit]
Description=Fablet API service
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/fablet-src/Backend
ExecStart=/usr/bin/env node /var/www/fablet-src/Backend/src/index.js
EnvironmentFile=/var/www/fablet-src/Backend/.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
