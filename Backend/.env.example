# Copy to .env and fill in real values. .env is gitignored; this file is not.
PORT=3000
NODE_ENV=development

# MongoDB connection string (Atlas or local). Keep this secret.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/FinalYearProjectFablet

# 32+ byte random hex strings, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-random-hex
JWT_REFRESH_SECRET=replace-with-another-random-hex

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
JWT_RESET_SECRET=replace-with-another-random-hex
JWT_VERIFY_SECRET=replace-with-another-random-hex
RESET_TOKEN_TTL=15m

# Origin the frontend dev server runs on (CORS + credentials).
FRONTEND_ORIGIN=http://localhost:5173
# Where the reset link points (defaults to FRONTEND_ORIGIN + /auth/reset).
# RESET_FRONTEND_URL=http://localhost:5173/auth/reset

# Set COOKIE_SECURE=true in production (served over HTTPS).
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# Email - self-hosted mail gateway (mailapi.artdevelopers.site -> docker-mailserver)
MAILAPI_URL=https://mailapi.artdevelopers.site
MAILAPI_KEY=replace-with-a-mailapi-key
MAIL_FROM=fablet@artdevelopers.site
MAIL_FROM_NAME=Fablet

# Cloudinary (asset storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Groq (LLM)
GROQ_API_KEY=
